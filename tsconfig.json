{
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "dist", ".output"],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "paths": {
      "#/*": ["./src/*"],
      "@/*": ["./src/*"],
      "@shared/*": ["./src/shared/src/*"],
      "@platform/tokens": ["./packages/tokens/src/index.ts"],
      "@platform/tokens/*": ["./packages/tokens/src/*"],
      "@platform/ports": ["./packages/ports/src/index.ts"],
      "@platform/ports/*": ["./packages/ports/src/*"],
      "@platform/ui": ["./packages/ui-core/src/index.ts"],
      "@platform/ui/*": ["./packages/ui-core/src/*"],
      "@platform/adapters": ["./packages/adapters/src/index.ts"],
      "@platform/adapters/*": ["./packages/adapters/src/*"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
